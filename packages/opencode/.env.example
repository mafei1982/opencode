# --- LLM Provider ---
# "local"    = In-process llama.cpp via node-llama-cpp (no HTTP calls)
# Unset or any other value = use cloud providers (anthropic, openai, etc.)
# LLM_PROVIDER=local

# --- Local Provider Settings (used when LLM_PROVIDER=local) ---
# Model path: local GGUF file or HuggingFace repo ID with optional :quant suffix
# Examples:
#   ./models/my-model.gguf       (local file)
#   unsloth/Qwen3.5-35B-A3B-GGUF:Q3_K_M  (HuggingFace auto-download)
# LLM_MODEL_PATH=unsloth/Qwen3.5-35B-A3B-GGUF:Q3_K_M

# Context window size (tokens)
# LLM_N_CTX=262144

# GPU layers to offload (-1 = all layers)
# LLM_N_GPU_LAYERS=-1

# KV cache quantization type (e.g. Q8_0, Q4_0, F16)
# LLM_CACHE_TYPE_K=Q8_0
# LLM_CACHE_TYPE_V=Q8_0

# Enable Flash Attention (reduces VRAM usage, allows larger context)
# LLM_FLASH_ATTENTION=true

# Disable thinking mode (set to "true" to skip <think>...</think> blocks)
# LLM_DISABLE_THINKING=false

# --- LLM Sampling Parameters ---
# LLM_TEMPERATURE=0.6
# LLM_TOP_P=0.95
# LLM_TOP_K=20
# LLM_MIN_P=0.0

# Model directory using LM Studio folder layout: <dir>/<publisher>/<repo>/<file>.gguf
# LLM_MODEL_DIR=./models

# --- Inference Settings ---
# LLM_INFERENCE_TIMEOUT=120  (seconds per inference call)
# LLM_INFERENCE_RETRIES=3    (retry count on timeout, with automatic model reload)

# --- Server Security ---
# OPENCODE_SERVER_PASSWORD=your-password-here
